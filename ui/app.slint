// Playtube-Fenster: Tab-Leiste, Navigationsleiste und Einstellungen. YouTube und YouTube Music
// sind WebView2-Kindfenster (src/browser.rs), die Rust über den Inhaltsbereich legt
// (content-top bis Fensterende).

import { Button, LineEdit, CheckBox, ComboBox, SpinBox, ScrollView, ProgressIndicator, GroupBox, Slider } from "std-widgets.slint";
import { Music, MusicView, PlayerBar, MusicCard, MusicShelf, MusicTexts } from "music.slint";
export { Music, MusicCard, MusicShelf, MusicTexts }

// Playtube Jam (src/jam.rs)
export struct JamTexts {
    tab: string,
    title: string,
    intro: string,
    name: string,
    start: string,
    join: string,
    code-placeholder: string,
    invite: string,
    copy: string,
    all-control: string,
    end: string,
    leave: string,
    members: string,
    queue: string,
    queue-empty: string,
    add: string,
    add-placeholder: string,
    add-current: string,
    results: string,
    nothing: string,
    hint: string,
    kick: string,
    play-now: string,
    remove: string,
    add-next: string,
    cant-play-here: string,
}

export struct JamMember {
    id: string,
    name: string,
    initial: string,
    info: string,
    host: bool,
    online: bool,
    can-kick: bool,
}

export struct JamItem {
    id: string,
    title: string,
    subtitle: string,
    can-jump: bool,
    can-remove: bool,
}

export struct Texts {
    tab-settings: string,
    url-placeholder: string,
    settings-title: string,
    version: string,
    save: string,
    section-discord: string,
    section-updates: string,
    section-audio: string,
    section-phone: string,
    section-general: string,
    field-enabled: string,
    field-client-id: string,
    field-update-interval: string,
    field-check-interval: string,
    field-youtube: string,
    field-music: string,
    field-start-tab: string,
    field-language: string,
    field-music-view: string,
    music-view-playtube: string,
    music-view-original: string,
    discord-show-idle: string,
    updates-check-now: string,
    updates-install: string,
    audio-hint: string,
    audio-mode: string,
    audio-mode-normal: string,
    audio-mode-stream: string,
    audio-mode-hint: string,
    phone-enabled: string,
    phone-hint: string,
    phone-pair: string,
    phone-forget: string,
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 100%;
    min-width: label.preferred-width + 32px;
    background: active ? #26262e : touch.has-hover ? #1c1c22 : transparent;
    border-radius: 6px;
    label := Text {
        text: root.text;
        color: root.active ? #ffffff : #b8b8c0;
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    Rectangle {
        visible: root.active;
        y: parent.height - 3px;
        height: 3px;
        width: parent.width - 20px;
        border-radius: 2px;
        background: @linear-gradient(90deg, #7c3aed 0%, #ec4899 100%);
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    width: 34px;
    height: 30px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? #2a2a33 : transparent;
    Text {
        text: root.text;
        color: root.enabled ? #e8e8ee : #5a5a64;
        // Windows-Symbolschrift (Windows 10/11): Zurück, Vor, Neu laden, Start.
        font-family: "Segoe MDL2 Assets";
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component Hint inherits Text {
    color: #a8a8b2;
    font-size: 12px;
    wrap: word-wrap;
}

component Row inherits HorizontalLayout {
    spacing: 12px;
    alignment: start;
}

component FieldLabel inherits Text {
    vertical-alignment: center;
    min-width: 210px;
    color: #e0e0e6;
}

// Runder Knopf mit Symbol aus "Segoe MDL2 Assets" (Jam-Steuerung, Listen).
component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <length> size: 36px;
    in property <string> tooltip;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.primary ? (root.enabled ? @linear-gradient(90deg, #7c3aed 0%, #ec4899 100%) : #3a3a44)
        : (touch.has-hover && root.enabled ? #2a2a33 : transparent);
    Text {
        text: root.icon;
        color: root.enabled ? #f2f2f6 : #5a5a64;
        font-family: "Segoe MDL2 Assets";
        font-size: root.size * 0.4;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component Card inherits Rectangle {
    background: #17171d;
    border-radius: 12px;
    border-width: 1px;
    border-color: #2a2a34;
}

component CardTitle inherits Text {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
}

export component AppWindow inherits Window {
    in property <string> window-title: "Playtube";
    title: root.window-title;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1366px;
    preferred-height: 860px;
    min-width: 640px;
    min-height: 420px;
    background: #0f0f12;
    default-font-family: "Segoe UI";

    in property <Texts> t;
    // 0 = YouTube, 1 = YouTube Music, 2 = Einstellungen
    in-out property <int> current-tab: 0;
    in property <bool> fullscreen-mode: false;
    // Oberkante des Bereichs, in dem die WebView2-Tabs liegen.
    out property <length> content-top: fullscreen-mode ? 0px : 88px;
    in-out property <string> url-text;

    // Einstellungen
    in-out property <bool> discord-enabled;
    in-out property <string> client-id;
    in-out property <int> discord-interval: 15;
    in-out property <bool> show-idle;
    in-out property <bool> updates-enabled;
    in-out property <int> check-interval: 6;
    in property <string> update-status;
    in property <bool> update-available;
    in property <bool> update-busy;
    // -1 = kein Download
    in property <float> update-progress: -1;
    in property <[string]> audio-devices;
    in-out property <int> youtube-output: 0;
    in-out property <int> music-output: 0;
    // 0 = normal (beste Qualität), 1 = für Discord-Streams (Ton über Playtube.exe)
    in-out property <int> audio-mode-index: 0;
    in-out property <bool> phone-enabled;
    in property <bool> phone-running;
    in property <string> phone-status;
    in property <string> phone-devices;
    in property <bool> phone-has-devices;
    in property <string> pairing-code;
    in property <[string]> languages;
    in-out property <int> language-index: 0;
    in-out property <int> start-tab-index: 0;
    // 0 = Playtube-Ansicht, 1 = Original-Seite von YouTube Music
    in-out property <int> music-view-index: 0;
    in property <string> saved-text;

    callback tab-selected(int);
    callback navigate(string);
    callback go-back();
    callback go-forward();
    callback reload();
    callback go-home();
    callback geometry-changed();
    callback save-settings();
    callback check-updates();
    callback install-update();
    callback pair-phone();
    callback forget-phones();

    // Playtube-Ansicht für YouTube Music (src/music.rs)
    in property <bool> music-view;
    // Google-Anmeldung läuft (Knopf "Fertig" in der Navigationsleiste)
    in property <bool> music-login;
    in property <string> music-view-label;
    callback toggle-music-view();

    // Jam
    in property <JamTexts> jt;
    in property <bool> jam-active;
    in property <bool> jam-busy;
    in-out property <string> jam-name;
    in-out property <string> jam-code-input;
    in property <string> jam-status;
    in property <string> jam-code;
    in property <string> jam-link;
    in property <image> jam-qr;
    in property <bool> jam-host;
    in property <bool> jam-can-control;
    in-out property <bool> jam-all-control;
    in property <string> jam-now-title;
    in property <string> jam-now-artist;
    in property <string> jam-time;
    in property <string> jam-duration;
    in property <float> jam-progress;
    in property <bool> jam-has-current;
    in property <bool> jam-paused: true;
    in property <bool> jam-cant-play;
    in property <[JamMember]> jam-members;
    in property <[JamItem]> jam-queue;
    in property <[JamItem]> jam-results;
    in property <string> jam-add-placeholder;
    in property <string> jam-add-label;
    in-out property <string> jam-add-input;

    callback jam-start();
    callback jam-join();
    callback jam-leave();
    callback jam-end();
    callback jam-copy-link();
    callback jam-play-pause();
    callback jam-next();
    callback jam-previous();
    callback jam-seek(float);
    callback jam-add();
    callback jam-add-current();
    callback jam-add-result(int, bool);
    callback jam-remove(string);
    callback jam-jump(string);
    callback jam-kick(string);
    callback jam-set-all-control(bool);

    changed width => { root.geometry-changed(); }
    changed height => { root.geometry-changed(); }
    changed content-top => { root.geometry-changed(); }

    VerticalLayout {
        // Tab-Leiste
        Rectangle {
            visible: !root.fullscreen-mode;
            height: root.fullscreen-mode ? 0px : 44px;
            background: #141419;
            HorizontalLayout {
                padding-left: 10px;
                padding-top: 6px;
                padding-bottom: 2px;
                spacing: 4px;
                Image {
                    source: @image-url("../assets/icon.png");
                    width: 22px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                }
                Rectangle { width: 6px; }
                TabButton { text: "YouTube"; active: root.current-tab == 0; clicked => { root.tab-selected(0); } }
                TabButton { text: "YouTube Music"; active: root.current-tab == 1; clicked => { root.tab-selected(1); } }
                TabButton { text: root.t.tab-settings; active: root.current-tab == 2; clicked => { root.tab-selected(2); } }
                TabButton {
                    text: root.jam-active ? "● " + root.jt.tab : root.jt.tab;
                    active: root.current-tab == 3;
                    clicked => { root.tab-selected(3); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        // Navigationsleiste
        Rectangle {
            visible: !root.fullscreen-mode;
            height: root.fullscreen-mode ? 0px : 44px;
            background: #141419;
            HorizontalLayout {
                padding: 6px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 4px;
                NavButton { text: "\u{E72B}"; enabled: root.current-tab < 2; clicked => { root.go-back(); } }
                NavButton { text: "\u{E72A}"; enabled: root.current-tab < 2; clicked => { root.go-forward(); } }
                NavButton { text: "\u{E72C}"; enabled: root.current-tab < 2; clicked => { root.reload(); } }
                NavButton { text: "\u{E80F}"; enabled: root.current-tab < 2; clicked => { root.go-home(); } }
                Rectangle { width: 6px; }
                if root.current-tab == 1 && root.music-login: Rectangle {
                    width: mv-text.preferred-width + 24px;
                    border-radius: 15px;
                    background: @linear-gradient(90deg, #7c3aed 0%, #ec4899 100%);
                    mv-text := Text { text: root.music-view-label; color: #ffffff; font-size: 12px; font-weight: 600; }
                    TouchArea { clicked => { root.toggle-music-view(); } }
                }
                url := LineEdit {
                    enabled: root.current-tab < 2;
                    text <=> root.url-text;
                    placeholder-text: root.t.url-placeholder;
                    accepted(text) => { root.navigate(text); }
                }
            }
        }
        // Inhalt: Einstellungen (die Browser-Tabs legt Rust als eigene Fenster darüber)
        Rectangle {
            vertical-stretch: 1;
            background: #0f0f12;
            if root.current-tab == 2: ScrollView {
                VerticalLayout {
                    padding: 28px;
                    padding-left: 32px;
                    padding-right: 32px;
                    spacing: 16px;
                    alignment: start;

                    VerticalLayout {
                        spacing: 2px;
                        Text { text: root.t.settings-title; font-size: 22px; font-weight: 600; color: #ffffff; }
                        Hint { text: root.t.version; }
                    }

                    GroupBox {
                        title: root.t.section-discord;
                        VerticalLayout {
                            spacing: 8px;
                            CheckBox { text: root.t.field-enabled; checked <=> root.discord-enabled; }
                            Row { FieldLabel { text: root.t.field-client-id; } LineEdit { text <=> root.client-id; min-width: 260px; } }
                            Row { FieldLabel { text: root.t.field-update-interval; } SpinBox { minimum: 15; maximum: 120; value <=> root.discord-interval; } }
                            CheckBox { text: root.t.discord-show-idle; checked <=> root.show-idle; }
                        }
                    }

                    GroupBox {
                        title: root.t.section-updates;
                        VerticalLayout {
                            spacing: 8px;
                            CheckBox { text: root.t.field-enabled; checked <=> root.updates-enabled; }
                            Row { FieldLabel { text: root.t.field-check-interval; } SpinBox { minimum: 1; maximum: 168; value <=> root.check-interval; } }
                            Row {
                                Button { text: root.t.updates-check-now; enabled: !root.update-busy; clicked => { root.check-updates(); } }
                                if root.update-available: Button { text: root.t.updates-install; primary: true; enabled: !root.update-busy; clicked => { root.install-update(); } }
                            }
                            Hint { text: root.update-status; }
                            if root.update-progress >= 0: ProgressIndicator { progress: root.update-progress; height: 6px; }
                        }
                    }

                    GroupBox {
                        title: root.t.section-audio;
                        VerticalLayout {
                            spacing: 8px;
                            Row { FieldLabel { text: root.t.field-youtube; } ComboBox { model: root.audio-devices; current-index <=> root.youtube-output; min-width: 360px; } }
                            Row { FieldLabel { text: root.t.field-music; } ComboBox { model: root.audio-devices; current-index <=> root.music-output; min-width: 360px; } }
                            Hint { text: root.t.audio-hint; }
                            Row { FieldLabel { text: root.t.audio-mode; } ComboBox { model: [root.t.audio-mode-normal, root.t.audio-mode-stream]; current-index <=> root.audio-mode-index; min-width: 360px; } }
                            Hint { text: root.t.audio-mode-hint; }
                        }
                    }

                    GroupBox {
                        title: root.t.section-phone;
                        VerticalLayout {
                            spacing: 8px;
                            CheckBox { text: root.t.phone-enabled; checked <=> root.phone-enabled; }
                            Row {
                                Button { text: root.t.phone-pair; enabled: root.phone-running; clicked => { root.pair-phone(); } }
                                Button { text: root.t.phone-forget; enabled: root.phone-has-devices; clicked => { root.forget-phones(); } }
                            }
                            if root.pairing-code != "": Text { text: root.pairing-code; font-size: 20px; font-weight: 600; color: #ffffff; }
                            Hint { text: root.phone-status; }
                            Hint { text: root.phone-devices; }
                            Hint { text: root.t.phone-hint; }
                        }
                    }

                    GroupBox {
                        title: root.t.section-general;
                        VerticalLayout {
                            spacing: 8px;
                            Row { FieldLabel { text: root.t.field-start-tab; } ComboBox { model: ["YouTube", "YouTube Music"]; current-index <=> root.start-tab-index; min-width: 200px; } }
                            Row { FieldLabel { text: root.t.field-language; } ComboBox { model: root.languages; current-index <=> root.language-index; min-width: 200px; } }
                            Row { FieldLabel { text: root.t.field-music-view; } ComboBox { model: [root.t.music-view-playtube, root.t.music-view-original]; current-index <=> root.music-view-index; min-width: 200px; } }
                        }
                    }

                    Row {
                        Button { text: root.t.save; primary: true; clicked => { root.save-settings(); } }
                        Hint { text: root.saved-text; vertical-alignment: center; }
                    }
                    Hint { text: "github.com/fojadrachi/Playtube"; }
                }
            }

            // Playtube-Ansicht für YouTube Music
            if root.current-tab == 1 && root.music-view: VerticalLayout {
                MusicView { vertical-stretch: 1; }
                PlayerBar { }
            }

            // Playtube Jam
            if root.current-tab == 3: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    padding-left: 32px;
                    padding-right: 32px;
                    spacing: 16px;
                    alignment: start;

                    VerticalLayout {
                        spacing: 2px;
                        Text { text: root.jt.title; font-size: 22px; font-weight: 600; color: #ffffff; }
                        Hint { text: root.jt.intro; }
                    }

                    // Noch in keinem Jam: starten oder beitreten
                    if !root.jam-active: Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Row { FieldLabel { text: root.jt.name; } LineEdit { text <=> root.jam-name; min-width: 260px; } }
                            Row {
                                Button { text: root.jt.start; primary: true; enabled: !root.jam-busy; clicked => { root.jam-start(); } }
                            }
                            Row {
                                LineEdit {
                                    text <=> root.jam-code-input;
                                    placeholder-text: root.jt.code-placeholder;
                                    min-width: 260px;
                                    accepted(text) => { root.jam-join(); }
                                }
                                Button { text: root.jt.join; enabled: !root.jam-busy; clicked => { root.jam-join(); } }
                            }
                            Hint { text: root.jam-status; }
                        }
                    }

                    if root.jam-active: HorizontalLayout {
                        spacing: 16px;

                        // Links: Wiedergabe, Hinzufügen, Warteschlange
                        VerticalLayout {
                            horizontal-stretch: 2;
                            spacing: 16px;
                            alignment: start;

                            Card {
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text {
                                        text: root.jam-has-current ? root.jam-now-title : root.jt.nothing;
                                        font-size: 18px;
                                        font-weight: 600;
                                        color: #ffffff;
                                        overflow: elide;
                                    }
                                    if root.jam-has-current: Hint { text: root.jam-now-artist; wrap: no-wrap; overflow: elide; }
                                    if root.jam-cant-play: Text { text: root.jt.cant-play-here; color: #fca5a5; font-size: 12px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Hint { text: root.jam-time; wrap: no-wrap; vertical-alignment: center; }
                                        Slider {
                                            minimum: 0;
                                            maximum: 1;
                                            value: root.jam-progress;
                                            enabled: root.jam-can-control && root.jam-has-current;
                                            released(value) => { root.jam-seek(value); }
                                        }
                                        Hint { text: root.jam-duration; wrap: no-wrap; vertical-alignment: center; }
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 14px;
                                        IconButton {
                                            icon: "\u{E892}";
                                            y: (parent.height - self.height) / 2;
                                            enabled: root.jam-can-control && root.jam-has-current;
                                            clicked => { root.jam-previous(); }
                                        }
                                        IconButton {
                                            icon: root.jam-paused ? "\u{E768}" : "\u{E769}";
                                            size: 48px;
                                            primary: true;
                                            enabled: root.jam-can-control && root.jam-has-current;
                                            clicked => { root.jam-play-pause(); }
                                        }
                                        IconButton {
                                            icon: "\u{E893}";
                                            y: (parent.height - self.height) / 2;
                                            enabled: root.jam-can-control;
                                            clicked => { root.jam-next(); }
                                        }
                                    }
                                }
                            }

                            Card {
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit {
                                            text <=> root.jam-add-input;
                                            placeholder-text: root.jam-add-placeholder;
                                            accepted(text) => { root.jam-add(); }
                                        }
                                        Button { text: root.jam-add-label; primary: true; clicked => { root.jam-add(); } }
                                    }
                                    Row { Button { text: root.jt.add-current; clicked => { root.jam-add-current(); } } }
                                    if root.jam-status != "": Hint { text: root.jam-status; }
                                    if root.jam-results.length > 0: CardTitle { text: root.jt.results; }
                                    for result[index] in root.jam-results: HorizontalLayout {
                                        spacing: 6px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Text { text: result.title; color: #f2f2f6; overflow: elide; }
                                            Hint { text: result.subtitle; wrap: no-wrap; overflow: elide; }
                                        }
                                        IconButton { icon: "\u{E70E}"; size: 30px; clicked => { root.jam-add-result(index, true); } }
                                        IconButton { icon: "\u{E710}"; size: 30px; clicked => { root.jam-add-result(index, false); } }
                                    }
                                    Rectangle { height: 4px; }
                                    CardTitle { text: root.jt.queue; }
                                    if root.jam-queue.length == 0: Hint { text: root.jt.queue-empty; }
                                    for item in root.jam-queue: HorizontalLayout {
                                        spacing: 6px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Text { text: item.title; color: #f2f2f6; overflow: elide; }
                                            Hint { text: item.subtitle; wrap: no-wrap; overflow: elide; }
                                        }
                                        if item.can-jump: IconButton { icon: "\u{E768}"; size: 30px; clicked => { root.jam-jump(item.id); } }
                                        if item.can-remove: IconButton { icon: "\u{E711}"; size: 30px; clicked => { root.jam-remove(item.id); } }
                                    }
                                }
                            }
                            Hint { text: root.jt.hint; }
                        }

                        // Rechts: Einladen, Einstellungen, Teilnehmer
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 260px;
                            spacing: 16px;
                            alignment: start;

                            Card {
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    CardTitle { text: root.jt.invite; }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;
                                        Rectangle {
                                            width: 132px;
                                            height: 132px;
                                            background: #ffffff;
                                            border-radius: 8px;
                                            Image { source: root.jam-qr; width: 120px; height: 120px; image-rendering: pixelated; }
                                        }
                                        VerticalLayout {
                                            spacing: 8px;
                                            alignment: center;
                                            Text { text: root.jam-code; font-size: 24px; font-weight: 700; color: #ffffff; letter-spacing: 2px; }
                                            Button { text: root.jt.copy; clicked => { root.jam-copy-link(); } }
                                        }
                                    }
                                    Hint { text: root.jam-link; }
                                }
                            }

                            Card {
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    if root.jam-host: CheckBox {
                                        text: root.jt.all-control;
                                        checked: root.jam-all-control;
                                        toggled => { root.jam-set-all-control(self.checked); }
                                    }
                                    Row {
                                        if root.jam-host: Button { text: root.jt.end; clicked => { root.jam-end(); } }
                                        Button { text: root.jt.leave; clicked => { root.jam-leave(); } }
                                    }
                                }
                            }

                            Card {
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    CardTitle { text: root.jt.members; }
                                    for member in root.jam-members: HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 30px;
                                            height: 30px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 15px;
                                            background: member.online ? @linear-gradient(135deg, #7c3aed 0%, #ec4899 100%) : #3a3a44;
                                            Text { text: member.initial; color: #ffffff; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Text { text: member.name; color: member.online ? #f2f2f6 : #8a8a94; overflow: elide; font-weight: member.host ? 600 : 400; }
                                            Hint { text: member.info; wrap: no-wrap; overflow: elide; }
                                        }
                                        if member.can-kick: IconButton { icon: "\u{E711}"; size: 28px; tooltip: root.jt.kick; clicked => { root.jam-kick(member.id); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
